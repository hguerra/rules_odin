"""Generated local-Git dependency integration workspace."""

module(
    name = "rules_odin_dependency_git_test",
    version = "0.0.0",
)

bazel_dep(name = "rules_odin", version = "0.2.0")
local_path_override(
    module_name = "rules_odin",
    path = "RULES_ODIN_PATH",
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "0.0.10")

odin = use_extension("@rules_odin//odin:extensions.bzl", "odin")
odin.toolchain(odin_version = "dev-2026-06")
use_repo(odin, "odin_toolchains")

odin_deps = use_extension("@rules_odin//odin:deps_extensions.bzl", "odin_deps")
odin_deps.git_repository(
    name = "parser",
    commit = "PARSER_COMMIT",
    package_path = "parser",
    remote = "https://git.invalid/parser.git",
    source_subdir = "src",
)
odin_deps.git_repository(
    name = "parser_bad",
    commit = "0000000000000000000000000000000000000000",
    package_path = "parser",
    remote = "https://git.invalid/parser.git",
    source_subdir = "src",
)
use_repo(odin_deps, "parser", "parser_bad")

register_toolchains("@odin_toolchains//:all")
